{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 900,
        "label": "main",
        "minHeight": 560,
        "minWidth": 800,
        "title": "Deadband",
        "width": 1440
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "longDescription": "Deadband passively watches OT network traffic, maps it onto the Purdue Model live, and gives early warning when traffic starts to look like an attack. It never transmits into the monitored network.",
    "shortDescription": "Real-time passive OT network monitor",
    "targets": "all"
  },
  "identifier": "io.github.banningstuckey.deadband",
  "productName": "Deadband",
  "version": "0.1.0"
}